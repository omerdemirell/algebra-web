---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sayfa Bulunamadı" noindex>
  <section class="not-found container">
    <span class="eyebrow">
      <i></i>404 / YOLUNU YENİDEN ÇİZ
    </span>
    <span class="error-number" aria-hidden="true">
      404
    </span>
    <h1>
      Burada bir sayfa yok.
      <br />
      Geleceğe başka bir yoldan gidelim.
    </h1>
    <p>Aradığınız içerik taşınmış olabilir. Menüden veya ana sayfadan devam edebilirsiniz.</p>
    <div>
      <a class="button" href="/">
        Ana Sayfaya Dön ↗
      </a>
      <a class="text-link" href="/hizmetler/">
        Hizmetleri İncele ↗
      </a>
    </div>
  </section>
</BaseLayout>
