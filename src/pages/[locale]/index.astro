---
import HomePage from '../../components/sections/HomePage.astro';
import { publishedLocales, type Locale } from '../../i18n/locales';
export function getStaticPaths() {
  return publishedLocales
    .filter((locale) => locale !== 'tr')
    .map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
---

<HomePage locale={locale} />
