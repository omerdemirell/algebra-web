---
import DetailPage from '../components/sections/DetailPage.astro';
import HubPage from '../components/sections/HubPage.astro';
import { detailPages, hubPages } from '../data/site';
import { publishedLocales, localePath } from '../i18n/locales';
export function getStaticPaths() {
  return publishedLocales.flatMap((locale) => [
    ...detailPages.map((page) => ({
      params: { slug: localePath(locale, `/${page.slug}/`).slice(1, -1) },
      props: { detail: page },
    })),
    ...hubPages.map((page) => ({
      params: { slug: localePath(locale, `/${page.slug}/`).slice(1, -1) },
      props: { hub: page },
    })),
  ]);
}
const { detail, hub } = Astro.props;
---

{detail && <DetailPage page={detail} />}
{hub && <HubPage page={hub} />}
