---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  href?: string;
  linkText?: string;
  accent?: string;
}
const { eyebrow, title, description, href, linkText, accent } = Astro.props;
---

<div class="section-heading">
  <div>
    <span class="eyebrow">
      <i></i>
      {eyebrow}
    </span>
    <h2>
      {title.split('\n').map((line) => (
        <span class="line">{line}</span>
      ))}
      {accent && <span class="line muted-heading">{accent}</span>}
    </h2>
    {description && <p>{description}</p>}
  </div>
  {href && (
    <a class="text-link" href={href}>
      {linkText}
      <span>↗</span>
    </a>
  )}
</div>
